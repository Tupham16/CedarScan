          }
        }
      }
    },
    "CedarScan needs camera access to scan in 3D. Turn it on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan potřebuje přístup k fotoaparátu, aby mohl skenovat ve 3D. Zapněte ho v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan benötigt Kamerazugriff, um in 3D zu scannen. Aktivieren Sie ihn in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan necesita acceso a la cámara para escanear en 3D. Actívalo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan a besoin d'accéder à la caméra pour numériser en 3D. Activez l'accès dans Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
