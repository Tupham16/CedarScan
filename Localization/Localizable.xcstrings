    "Rescanning the flagged floors usually gives a more accurate floor plan: %@. You can still order — our team will be notified.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové naskenování označených podlaží obvykle přinese přesnější půdorys: %@. Objednat můžete i tak — náš tým dostane upozornění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Neuscan der markierten Etagen ergibt meist einen genaueren Grundriss: %@. Sie können trotzdem bestellen — unser Team wird informiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a escanear las plantas marcadas suele dar un plano de planta más preciso: %@. Aun así puedes pedir — avisaremos a nuestro equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre la numérisation des étages signalés donne habituellement un plan d'étage plus précis : %@. Vous pouvez quand même commander — notre équipe en sera avisée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemarkeerde verdiepingen opnieuw scannen geeft meestal een nauwkeurigere plattegrond: %@. Je kunt nog steeds bestellen — ons team wordt op de hoogte gebracht."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opätovné naskenovanie označených podlaží zvyčajne dá presnejší pôdorys: %@. Aj tak môžete objednať — náš tím bude upozornený."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét lại các tầng bị đánh dấu thường cho bản vẽ chính xác hơn: %@. Bạn vẫn có thể đặt — đội xử lý sẽ được báo trước."
          }
        }
      }
    },
