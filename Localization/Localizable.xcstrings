    "Do I need one order per floor?": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebuji pro každé podlaží samostatnou objednávku?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauche ich pro Etage eine eigene Bestellung?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesito un pedido por cada planta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois-je passer une commande par étage?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb ik voor elke verdieping een aparte bestelling nodig?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebujem na každé podlažie samostatnú objednávku?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có phải đặt mỗi tầng một đơn không?"
          }
        }
      }
    },
    "Do NOT stop between floors. Walk up the stairs while still scanning — that is what keeps the floors stacked correctly in 3D.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi podlažími se NEZASTAVUJTE. Jděte po schodech nahoru a přitom dál skenujte — právě to udrží podlaží ve 3D správně nad sebou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie NICHT zwischen den Etagen. Gehen Sie die Treppe hinauf und scannen Sie dabei weiter — genau das hält die Etagen in 3D korrekt übereinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO te detengas entre plantas. Sube las escaleras sin dejar de escanear — eso es lo que mantiene las plantas bien apiladas en 3D."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous arrêtez PAS entre les étages. Montez l'escalier sans cesser de numériser — c'est ce qui garde les étages bien superposés en 3D."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop NIET tussen de verdiepingen. Loop de trap op terwijl je blijft scannen — dat houdt de verdiepingen in 3D goed op elkaar gestapeld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi podlažiami sa NEZASTAVUJTE. Choďte hore schodmi a pritom stále skenujte — práve vďaka tomu zostanú podlažia v 3D správne nad sebou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ĐỪNG dừng giữa các tầng. Vừa quét vừa đi lên cầu thang — đó là thứ giữ các tầng chồng đúng nhau trong 3D."
          }
        }
      }
    },
