    "Saving works the processor hard, so if another area is still to scan, let the phone rest a few minutes first.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání dá procesoru zabrat, takže pokud vás čeká ještě další část, nechte telefon nejdřív pár minut odpočinout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern beansprucht den Prozessor stark. Wenn danach noch ein Bereich zu scannen ist, lassen Sie das iPhone zuerst ein paar Minuten abkühlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado exige mucho al procesador, así que si aún queda otra zona por escanear, deja que el teléfono descanse unos minutos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement sollicite fortement le processeur — s'il vous reste une zone à numériser, laissez d'abord le téléphone refroidir quelques minutes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan vraagt veel van de processor, dus als je nog een ander deel moet scannen, laat de telefoon dan eerst een paar minuten rusten."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladanie poriadne zaťaží procesor, takže ak ešte máte skenovať ďalšiu časť, nechajte telefón najprv pár minút vychladnúť."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc lưu máy chạy hết công suất để dựng mô hình, nên nếu còn khu khác phải quét thì để máy nghỉ vài phút cho nguội đã."
          }
        }
      }
    },
