            "state": "translated",
            "value": "3D-Datei wird geschrieben …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando el archivo 3D…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écriture du fichier 3D…"
          }
        },
        "nl": {
