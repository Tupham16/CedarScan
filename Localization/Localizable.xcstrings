    },
    "Check the inbox (and spam folder) of %@. The code expires in 15 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte doručenou poštu (i složku spam) adresy %@. Platnost kódu vyprší za 15 minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie den Posteingang (und den Spam-Ordner) von %@. Der Code läuft in 15 Minuten ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la bandeja de entrada (y la carpeta de spam) de %@. El código expira en 15 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la boîte de réception de %@, y compris le courrier indésirable. Le code expire dans 15 minutes."
          }
        },
        "nl": {
          "stringUnit": {
