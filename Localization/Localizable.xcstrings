    },
    "Write to %@. If it is about one particular order, add the order number and we will be quicker.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište na %@. Pokud jde o konkrétní objednávku, připište její číslo — vyřídíme to rychleji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie an %@. Geht es um eine bestimmte Bestellung, nennen Sie die Bestellnummer — dann sind wir schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe a %@. Si es sobre un pedido en particular, incluye el número de pedido y te atenderemos más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez à %@. Si c'est au sujet d'une commande en particulier, ajoutez le numéro de commande et nous irons plus vite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail naar %@. Gaat het over één specifieke bestelling, zet er dan het bestelnummer bij — dan kunnen we je sneller helpen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte na %@. Ak ide o jednu konkrétnu objednávku, pridajte číslo objednávky a vybavíme to rýchlejšie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn viết cho %@ nhé. Hỏi về một đơn cụ thể thì kèm số đơn cho nhanh."
          }
        }
      }
    },
    "Writing the 3D file…": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisování 3D souboru…"
          }
        },
        "de": {
