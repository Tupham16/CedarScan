    "Deletes your account and the scans we hold in the cloud. Scans on this iPhone are not affected. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže váš účet a skeny, které uchováváme v cloudu. Skeny v tomto iPhonu zůstanou nedotčené. Tuto akci nelze vzít zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Ihr Konto und die Scans, die wir in der Cloud speichern. Scans auf diesem iPhone sind nicht betroffen. Dies lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y los escaneos que guardamos en la nube. Los escaneos en este iPhone no se ven afectados. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre compte et les numérisations que nous conservons sur nos serveurs. Les numérisations sur cet iPhone ne sont pas touchées. Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je account en de scans die wij in de cloud bewaren. Scans op deze iPhone blijven behouden. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže váš účet a skeny, ktoré uchovávame v cloude. Skeny v tomto iPhone zostanú nedotknuté. Táto akcia sa nedá vrátiť späť."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản và các bản quét đang nằm trên máy chủ. Bản quét trong máy này không bị ảnh hưởng. Không thể hoàn tác."
          }
        }
      }
    },
