    "Add 1–3 photos per room. Our team will pin them to the right spot on your floor plan and you'll get a shareable tour link with your delivery.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte 1–3 fotky ke každé místnosti. Náš tým je připne na správné místo na vašem půdorysu a spolu s dodáním dostanete odkaz na prohlídku, který můžete sdílet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie 1–3 Fotos pro Raum hinzu. Unser Team pinnt sie an die richtige Stelle auf Ihrem Grundriss, und mit der Lieferung erhalten Sie einen Rundgang-Link zum Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade 1–3 fotos por habitación. Nuestro equipo las fijará en el punto exacto de tu plano de planta y con tu entrega recibirás un enlace del tour para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez 1 à 3 photos par pièce. Notre équipe les épinglera au bon endroit sur votre plan d'étage et vous recevrez, avec votre livraison, un lien de visite à partager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 1–3 foto's per kamer toe. Ons team pint ze vast op de juiste plek op je plattegrond en bij je levering krijg je een deelbare tourlink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte 1–3 fotky na miestnosť. Náš tím ich pripne na správne miesto na vašom pôdoryse a spolu s dodaním dostanete odkaz na prehliadku, ktorý môžete zdieľať."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm 1–3 ảnh cho mỗi phòng. Đội ngũ sẽ ghim ảnh vào đúng vị trí trên mặt bằng — khi giao hàng bạn sẽ nhận link tour để chia sẻ."
          }
        }
      }
    },
