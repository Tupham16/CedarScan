        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara a cada pared, esquina, puerta y ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez la caméra vers chaque mur, coin, porte et fenêtre."
          }
        },
