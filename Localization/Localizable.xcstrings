        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite. Veuillez réessayer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo. Skúste to znova, prosím."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi xảy ra. Vui lòng thử lại."
          }
        }
      }
    },
    "Spin the model to check for any room you missed.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otáčejte modelem a zkontrolujte, jestli jste nevynechali některou místnost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie das Modell und prüfen Sie, ob Sie einen Raum übersehen haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira el modelo para ver si te faltó alguna habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites pivoter le modèle pour vérifier qu'aucune pièce n'a été oubliée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai het model rond om te zien of je geen kamer hebt gemist."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otáčajte modelom a skontrolujte, či ste nevynechali žiadnu miestnosť."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay mô hình để chắc không sót phòng nào."
          }
        }
      }
    },
    "Start scanning": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začít skenovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a escanear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer la numérisation"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen met scannen"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začať skenovať"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu quét"
          }
        }
      }
    },
    "Step back a little": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochu poodstupte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Schritt zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aléjate un poco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reculez un peu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe een stapje terug"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochu ustúpte"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lùi ra xa một chút"
          }
        }
      }
    },
    "Still looking… no luck. Type the address instead.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále hledáme… bez úspěchu. Zadejte adresu ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche läuft … leider ohne Treffer. Geben Sie die Adresse bitte selbst ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos buscando… sin suerte. Escribe la dirección a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche toujours en cours… sans résultat. Saisissez plutôt l'adresse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog steeds aan het zoeken… zonder succes. Typ het adres zelf in."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále hľadáme… bez výsledku. Zadajte adresu ručne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tìm được vị trí. Bạn nhập địa chỉ bằng tay nhé."
          }
        }
      }
    },
    "Stop & Save": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavit a uložit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen & Speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener y guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter et enregistrer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen & opslaan"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaviť a uložiť"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng & Lưu"
          }
        }
      }
    },
    "Sweep the ceiling once in each room so the room closes up as a solid volume.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V každé místnosti jednou přejeďte fotoaparátem po stropě, aby se místnost uzavřela jako celistvý objem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwenken Sie in jedem Raum einmal über die Decke, damit sich der Raum zu einem geschlossenen Volumen schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa la cámara por el techo una vez en cada habitación para que el espacio se cierre como un volumen sólido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez le plafond une fois dans chaque pièce pour que la pièce se referme en un volume plein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga in elke kamer één keer met de camera over het plafond, zodat de kamer een gesloten volume vormt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V každej miestnosti raz prejdite fotoaparátom po strope, aby sa miestnosť uzavrela do celistvého objemu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lia lên trần một lượt ở mỗi phòng để hình khối phòng khép kín."
          }
        }
      }
    },
    "TIP: One order covers the WHOLE home — select the other floors above instead of ordering them separately!": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "TIP: Jedna objednávka pokrývá CELÝ dům — vyberte výše ostatní podlaží, místo abyste je objednávali zvlášť!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TIPP: Eine Bestellung deckt das GANZE Haus ab — wählen Sie oben die anderen Etagen aus, statt sie einzeln zu bestellen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CONSEJO: un pedido cubre TODA la vivienda — ¡selecciona las otras plantas arriba en lugar de pedirlas por separado!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASTUCE : une seule commande couvre TOUTE la maison — sélectionnez les autres étages ci-dessus au lieu de les commander séparément!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TIP: Eén bestelling dekt de HELE woning — selecteer hierboven de andere verdiepingen in plaats van ze apart te bestellen!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "TIP: Jedna objednávka pokrýva CELÝ dom — namiesto samostatného objednávania vyberte ostatné podlažia vyššie!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MẸO: MỘT đơn tính giá cho CẢ căn nhà — hãy chọn thêm các tầng ở trên thay vì đặt lẻ từng tầng!"
          }
        }
      }
    },
    "Take the case off and stay out of direct sun — it keeps the phone from throttling.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundejte kryt a vyhněte se přímému slunci — telefon se pak nepřehřívá a nezpomaluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie die Hülle ab und bleiben Sie aus der direkten Sonne — so drosselt das iPhone die Leistung nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quítale la funda y evita el sol directo — así el teléfono no pierde rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez l'étui et restez à l'abri du soleil direct — cela évite au téléphone de brider ses performances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal het hoesje eraf en blijf uit de directe zon — zo voorkom je dat de telefoon zichzelf afremt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zložte kryt a vyhýbajte sa priamemu slnku — telefón tak neobmedzí svoj výkon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháo ốp lưng, tránh nắng trực tiếp — đỡ bị máy bóp hiệu năng."
          }
        }
      }
    },
    "Take the stairs extra slowly, keeping the steps in view.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po schodech jděte obzvlášť pomalu a mějte je stále v záběru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie Treppen besonders langsam und behalten Sie die Stufen im Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las escaleras muy despacio, manteniendo los escalones a la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez l'escalier très lentement, en gardant les marches dans le cadre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem de trap extra langzaam en houd de treden in beeld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po schodoch choďte obzvlášť pomaly a stupne majte stále v zábere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên cầu thang thật chậm, giữ bậc thang trong khung hình."
          }
        }
      }
    },
    "Tap \"Pay Now\" — on the screen right after you order, or in the Orders tab. It opens the payment page in your browser. No button yet? Give it a few minutes; the link reaches your email.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na \"Zaplatit nyní\" — na obrazovce hned po objednání, nebo na záložce Objednávky. Tlačítko otevře platební stránku ve vašem prohlížeči. Tlačítko zatím nikde? Dejte tomu pár minut; odkaz vám dorazí na e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf \"Jetzt bezahlen\" — auf dem Bildschirm direkt nach der Bestellung oder im Tab \"Bestellungen\". Er öffnet die Zahlungsseite in Ihrem Browser. Noch kein Button? Warten Sie ein paar Minuten — der Link kommt per E-Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca \"Pagar ahora\" — en la pantalla justo después de pedir, o en la pestaña Pedidos. Se abre la página de pago en tu navegador. ¿Aún no ves el botón? Dale unos minutos; el enlace llegará a tu correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez \"Payer maintenant\" — sur l'écran juste après la commande, ou dans l'onglet Commandes. Le bouton ouvre la page de paiement dans votre navigateur. Pas encore de bouton? Patientez quelques minutes; le lien arrive dans votre boîte courriel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op \"Nu betalen\" — op het scherm direct na het bestellen, of in het tabblad Bestellingen. De knop opent de betaalpagina in je browser. Nog geen knop? Geef het een paar minuten; de link komt in je mailbox."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na \"Zaplatiť teraz\" — na obrazovke hneď po objednaní alebo na karte Objednávky. Otvorí sa platobná stránka vo vašom prehliadači. Tlačidlo ešte nevidíte? Počkajte pár minút; odkaz vám príde na e-mail."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bấm \"Thanh toán ngay\" — ở màn hình ngay sau khi đặt, hoặc ở tab Đơn hàng. Nút mở trang thanh toán bằng trình duyệt. Chưa thấy nút thì đợi vài phút, link sẽ tới email của bạn."
          }
        }
      }
    },
    "Tap Stop & Save, NAME the scan and tap Save — the scan is still recording until you do. Only then put the phone down.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Zastavit a uložit, sken POJMENUJTE a klepněte na Uložit — do té doby se sken stále nahrává. Teprve potom telefon odložte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Stoppen & Speichern, BENENNEN Sie den Scan und tippen Sie auf Speichern — bis dahin nimmt der Scan weiter auf. Legen Sie das iPhone erst danach weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Detener y guardar, PONLE NOMBRE al escaneo y toca Guardar — el escaneo sigue grabando hasta que lo hagas. Solo entonces deja el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Arrêter et enregistrer, NOMMEZ la numérisation puis touchez Enregistrer — la numérisation continue tant que ce n'est pas fait. Ne posez le téléphone qu'ensuite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Stoppen & opslaan, geef de scan een NAAM en tik op Opslaan — de scan blijft opnemen tot je dat doet. Leg de telefoon pas daarna neer."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na Zastaviť a uložiť, sken POMENUJTE a ťuknite na Uložiť — dovtedy sken stále nahráva. Až potom telefón odložte."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm Dừng & Lưu, ĐẶT TÊN bản quét rồi bấm Lưu — chưa bấm là máy vẫn đang quét tiếp. Xong bước đó mới đặt máy xuống."
          }
        }
      }
    },
    "Tap the Scan button in the middle of the bottom bar to scan your first space. Every scan is filed under the home address you enter.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na tlačítko Skenovat uprostřed spodní lišty a naskenujte svůj první prostor. Každý sken se zařadí pod adresu domu, kterou zadáte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf den Scan-Button in der Mitte der unteren Leiste, um Ihren ersten Bereich zu scannen. Jeder Scan wird unter der Hausadresse abgelegt, die Sie eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón Escanear en el centro de la barra inferior para escanear tu primer espacio. Cada escaneo se guarda en la dirección de la vivienda que escribas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton Numériser au milieu de la barre du bas pour numériser votre premier espace. Chaque numérisation est classée sous l'adresse de la maison que vous saisissez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop Scan in het midden van de balk onderaan om je eerste ruimte te scannen. Elke scan wordt bewaard onder het woningadres dat je invoert."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na tlačidlo Skenovať v strede spodnej lišty a naskenujte svoj prvý priestor. Každý sken sa uloží pod adresu domu, ktorú zadáte."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm nút Scan ở giữa thanh dưới để quét không gian đầu tiên. Mỗi bản quét sẽ tự vào dự án theo địa chỉ bạn nhập."
          }
        }
      }
    },
    "Terms and Conditions": {
      "extractionState": "manual",
      "localizations": {
