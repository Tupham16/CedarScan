    "No 3D model in this scan — our team cannot draw a floor plan from it. Please scan this area again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento sken neobsahuje 3D model — náš tým z něj nemůže nakreslit půdorys. Naskenujte prosím tuto oblast znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein 3D-Modell in diesem Scan — unser Team kann daraus keinen Grundriss zeichnen. Bitte scannen Sie diesen Bereich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este escaneo no tiene modelo 3D — nuestro equipo no puede dibujar un plano de planta a partir de él. Vuelve a escanear esta zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette numérisation ne contient aucun modèle 3D — notre équipe ne peut donc pas dessiner de plan d'étage. Veuillez numériser cette zone de nouveau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen 3D-model in deze scan — ons team kan er geen plattegrond van tekenen. Scan dit gedeelte opnieuw."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto skene nie je 3D model — náš tím z neho nedokáže nakresliť pôdorys. Naskenujte túto oblasť znova, prosím."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản quét này chưa thu được mô hình 3D — đội vẽ không dựng được mặt bằng, hãy quét lại khu này."
          }
        }
      }
    },
    "No homes or scans match \"%@\".": {
