    "Free order — no payment needed. Our team starts right after you place it.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objednávka zdarma — platba není potřeba. Náš tým začne pracovat hned po jejím odeslání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-Bestellung — keine Zahlung nötig. Unser Team beginnt direkt nach dem Aufgeben der Bestellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido gratis — no hace falta pagar. Nuestro equipo empieza justo después de que lo realices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande gratuite — aucun paiement requis. Notre équipe commence dès que vous la passez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis bestelling — geen betaling nodig. Ons team gaat direct na het plaatsen aan de slag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná objednávka — platba nie je potrebná. Náš tím začne hneď po odoslaní objednávky."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn miễn phí — không cần thanh toán, đội ngũ bắt đầu ngay sau khi đặt."
          }
        }
      }
    },
