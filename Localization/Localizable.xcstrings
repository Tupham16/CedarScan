    "After that the screen stays on by itself until saving finishes — leave the phone alone.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka pak zůstane sama zapnutá, dokud se ukládání nedokončí — nechte telefon být."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach bleibt der Bildschirm von selbst an, bis das Speichern abgeschlossen ist — lassen Sie das iPhone einfach liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, la pantalla se mantiene encendida sola hasta que termine el guardado — no toques el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, l'écran reste allumé de lui-même jusqu'à la fin de l'enregistrement — laissez le téléphone tranquille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna blijft het scherm vanzelf aan tot het opslaan klaar is — laat de telefoon met rust."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom zostane obrazovka sama zapnutá, kým sa ukladanie nedokončí — telefón nechajte na pokoji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó màn hình tự sáng cho tới khi lưu xong — cứ để yên máy, đừng chạm vào."
          }
        }
      }
    },
    "Alerts while scanning when you move or turn too fast, light is low, or you get too close.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění během skenování, když se pohybujete nebo otáčíte příliš rychle, je málo světla nebo jste příliš blízko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise beim Scannen, wenn Sie sich zu schnell bewegen oder drehen, das Licht schwach ist oder Sie zu nah herangehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas mientras escaneas cuando te mueves o giras demasiado rápido, hay poca luz o te acercas demasiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes pendant la numérisation lorsque vous bougez ou tournez trop vite, que l'éclairage est faible ou que vous êtes trop près."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen tijdens het scannen wanneer je te snel beweegt of draait, er weinig licht is of je te dichtbij komt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia počas skenovania, keď sa pohybujete alebo otáčate príliš rýchlo, keď je málo svetla alebo ste príliš blízko."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo trong lúc quét khi đi/xoay nhanh quá, thiếu sáng hoặc dí quá sát."
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše"
          }
