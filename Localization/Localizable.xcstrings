    "CedarScan measures with the LiDAR sensor, which this iPhone does not have. You need an iPhone Pro (12 Pro or newer).": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan měří pomocí senzoru LiDAR, který tento iPhone nemá. Potřebujete iPhone Pro (12 Pro nebo novější)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan misst mit dem LiDAR-Sensor, den dieses iPhone nicht hat. Sie benötigen ein iPhone Pro (12 Pro oder neuer)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan mide con el sensor LiDAR, y este iPhone no lo tiene. Necesitas un iPhone Pro (12 Pro o posterior)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan mesure avec le capteur LiDAR, que cet iPhone n'a pas. Il vous faut un iPhone Pro (12 Pro ou plus récent)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan meet met de LiDAR-sensor en die heeft deze iPhone niet. Je hebt een iPhone Pro (12 Pro of nieuwer) nodig."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan meria pomocou senzora LiDAR, ktorý tento iPhone nemá. Potrebujete iPhone Pro (12 Pro alebo novší)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan đo bằng cảm biến LiDAR mà iPhone này không có. Bạn cần iPhone bản Pro (12 Pro trở lên)."
          }
        }
      }
    },
    "CedarScan needs an iPhone Pro (12 Pro or newer) with a LiDAR sensor.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
