    "A marked-up photo or PDF helps us find exactly what to fix.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka nebo PDF s vyznačenými místy nám pomůže najít přesně to, co máme opravit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein markiertes Foto oder PDF zeigt uns genau, was zu korrigieren ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto o un PDF con anotaciones nos ayuda a encontrar exactamente qué corregir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo ou un PDF annoté nous aide à trouver exactement quoi corriger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gemarkeerde foto of PDF helpt ons precies te vinden wat we moeten aanpassen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka alebo PDF s vyznačenými miestami nám pomôže nájsť presne to, čo treba opraviť."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp/PDF có đánh dấu giúp đội vẽ tìm đúng chỗ cần sửa."
          }
        }
      }
    },
