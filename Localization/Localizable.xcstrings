    "Location is off for CedarScan. Turn it on in Settings, or just type the address below.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan nemá povolený přístup k poloze. Zapněte ho v Nastavení, nebo adresu prostě napište níže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff für CedarScan ist deaktiviert. Aktivieren Sie ihn in den Einstellungen — oder geben Sie die Adresse einfach unten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está desactivada para CedarScan. Actívala en Configuración o simplemente escribe la dirección abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée pour CedarScan. Activez-la dans Réglages, ou saisissez simplement l'adresse ci-dessous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie staat uit voor CedarScan. Zet dit aan in Instellingen, of typ het adres gewoon hieronder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CedarScan nemá povolený prístup k polohe. Zapnite ho v Nastaveniach alebo jednoducho zadajte adresu nižšie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
