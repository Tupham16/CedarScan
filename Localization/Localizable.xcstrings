        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete sken a klepněte na \"Objednat půdorys\" — náš tým vám vytvoří profesionální výkresy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einen Scan und tippen Sie auf \"Grundriss bestellen\", damit unser Team professionelle Zeichnungen erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un escaneo y toca \"Pedir plano de planta\" para que nuestro equipo cree planos profesionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une numérisation et touchez \"Commander le plan d'étage\" pour que notre équipe crée des plans professionnels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een scan en tik op \"Plattegrond bestellen\" om ons team professionele tekeningen te laten maken."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte sken a ťuknite na \"Objednať pôdorys\" — náš tím vám vytvorí profesionálne výkresy."
          }
        },
        "vi": {
